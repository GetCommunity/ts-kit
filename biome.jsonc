{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "extends": [
    "./biome.base.jsonc",
    "./biome.solid.jsonc",
    "./biome.tailwind.jsonc",
    "./biome.lib.jsonc"
  ],
  "files": {
    // No "**" catch-all here: a second one after the extended configs' own "**"
    // would re-include everything under it (gitignore-style, last match wins),
    // silently undoing every exclusion those configs declared.
    "includes": [
      // Generated by `pnpm r:build`; not gitignored because it's the published registry output, but it's disposable/regenerated, not source.
      "!!**/public/r"
    ]
  }
}
