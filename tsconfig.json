{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "rootDir": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "~/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": [
      "@types/node",
      "@testing-library/jest-dom/vitest",
      "vitest/globals",
      "vite/client"
    ]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts"],
  "exclude": [
    ".idea",
    ".output",
    ".tanstack",
    "dist",
    "node_modules",
    "public/r",
    // Registry templates for consuming projects' own eslint.config.ts — they
    // import packages (@tanstack/eslint-config, typescript-eslint,
    // @ospm/eslint-plugin-valibot) that are intentionally not dependencies of
    // ts-kit itself, so they can't type-check in this project's context.
    "registry/config/eslint"
  ]
}
