{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "config-prettier",
      "type": "registry:item",
      "title": "Prettier Config",
      "description": "A prettier config for typescript.",
      "devDependencies": ["prettier", "prettier-plugin-organize-imports"],
      "files": [
        {
          "path": "prettier-config.json",
          "type": "registry:file",
          "target": "@/prettier.config.js"
        }
      ]
    },
    {
      "name": "config-prettier-lib",
      "type": "registry:item",
      "title": "Prettier Config for Packages/Libraries",
      "description": "A prettier config for typescript packages/libraries.",
      "devDependencies": ["prettier", "prettier-plugin-organize-imports"],
      "files": [
        {
          "path": "package.js",
          "type": "registry:file",
          "target": "@/prettier.config.js"
        }
      ]
    },
    {
      "name": "config-prettier-app",
      "type": "registry:item",
      "title": "Prettier Config for Apps",
      "description": "A prettier config for typescript applications.",
      "devDependencies": ["prettier", "prettier-plugin-organize-imports"],
      "files": [
        {
          "path": "app.js",
          "type": "registry:file",
          "target": "@/prettier.config.js"
        }
      ]
    },
    {
      "name": "config-prettier-app-tailwind",
      "type": "registry:item",
      "title": "Prettier Config for Tailwind Apps",
      "description": "A prettier config for typescript apps using tailwindcss.",
      "devDependencies": [
        "prettier",
        "prettier-plugin-tailwindcss",
        "prettier-plugin-organize-imports"
      ],
      "files": [
        {
          "path": "app-tailwind.js",
          "type": "registry:file",
          "target": "@/prettier.config.js"
        }
      ]
    }
  ]
}
