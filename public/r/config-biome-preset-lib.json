{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "config-biome-preset-lib",
  "title": "Biome Preset: Plain Library",
  "description": "Root biome.jsonc for a plain TypeScript/Node library published for other packages to import — no Solid.js, no Tailwind CSS.",
  "registryDependencies": [
    "getcommunity/ts-kit/config-biome-base",
    "getcommunity/ts-kit/config-biome-lib"
  ],
  "files": [
    {
      "path": "registry/config/biome/biome.preset.lib.jsonc",
      "content": "{\n  \"$schema\": \"https://biomejs.dev/schemas/2.5.13/schema.json\",\n  \"extends\": [\"./biome.base.jsonc\", \"./biome.lib.jsonc\"]\n}\n",
      "type": "registry:file",
      "target": "biome.jsonc"
    }
  ],
  "type": "registry:item"
}