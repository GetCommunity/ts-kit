{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "config-biome-preset-solid-tailwind-app",
  "title": "Biome Preset: Solid + Tailwind App",
  "description": "Root biome.jsonc for a Solid.js application styled with Tailwind (e.g. a TanStack Start app deployed to Cloudflare Workers).",
  "registryDependencies": [
    "getcommunity/ts-kit/config-biome-base",
    "getcommunity/ts-kit/config-biome-solid",
    "getcommunity/ts-kit/config-biome-tailwind",
    "getcommunity/ts-kit/config-biome-app"
  ],
  "files": [
    {
      "path": "registry/config/biome/biome.preset.solid-tailwind-app.jsonc",
      "content": "{\n  \"$schema\": \"https://biomejs.dev/schemas/2.5.13/schema.json\",\n  \"extends\": [\n    \"./biome.base.jsonc\",\n    \"./biome.solid.jsonc\",\n    \"./biome.tailwind.jsonc\",\n    \"./biome.app.jsonc\"\n  ]\n}\n",
      "type": "registry:file",
      "target": "biome.jsonc"
    }
  ],
  "type": "registry:item"
}