{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "config-ts-lib",
  "title": "Typescript Config Packages/Libraries",
  "description": "A typescript config for packages/libraries.",
  "devDependencies": [
    "typescript"
  ],
  "files": [
    {
      "path": "registry/config/tsconfig/tsconfig.ts-package.json",
      "content": "{\n  \"$schema\": \"https://json.schemastore.org/tsconfig\",\n  \"display\": \"Typescript Library TSConfig\",\n  \"extends\": \"./tsconfig.base.json\",\n  \"compilerOptions\": {\n    \"target\": \"ESNext\",\n    \"module\": \"NodeNext\",\n    \"moduleResolution\": \"NodeNext\",\n    \"lib\": [\"ESNext\"],\n    \"newLine\": \"LF\",\n    \"allowJs\": false,\n    \"sourceMap\": true,\n    \"types\": [\"@types/node\"]\n  }\n}\n",
      "type": "registry:file",
      "target": "@/tsconfig.json"
    }
  ],
  "type": "registry:item"
}