{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "config-ts-lib-solid",
  "title": "Typescript Config SolidJs Library",
  "description": "A typescript config for SolidJs packages/libraries.",
  "dependencies": [
    "solid-js"
  ],
  "devDependencies": [
    "typescript",
    "@testing-library/jest-dom",
    "vite",
    "vitest"
  ],
  "registryDependencies": [
    "getcommunity/ts-kit/config-ts-base"
  ],
  "files": [
    {
      "path": "registry/config/tsconfig/tsconfig.solidjs-lib.json",
      "content": "{\n  \"$schema\": \"https://json.schemastore.org/tsconfig\",\n  \"display\": \"SolidJs Library TSConfig\",\n  \"extends\": \"./tsconfig.base.json\",\n  \"compilerOptions\": {\n    \"target\": \"ESNext\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Bundler\",\n    \"jsx\": \"preserve\",\n    \"jsxImportSource\": \"solid-js\",\n    \"lib\": [\"DOM\", \"DOM.Iterable\", \"ESNext\"],\n    \"newLine\": \"LF\",\n    \"allowJs\": false,\n    \"sourceMap\": true,\n    \"isolatedModules\": true,\n    \"types\": [\n      \"@testing-library/jest-dom/vitest\",\n      \"vite/client\",\n      \"node\",\n      \"vitest/globals\"\n    ]\n  },\n  \"exclude\": [\n    \"node_modules/\",\n    \"build/\",\n    \"dist/\",\n    \"scripts/\",\n    \"public/\",\n    \".wrangler/\",\n    \".vinxi/\",\n    \".vercel/\",\n    \".tmp/\"\n  ]\n}\n",
      "type": "registry:file",
      "target": "tsconfig.lib.json"
    }
  ],
  "type": "registry:item"
}