{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "tskit",
  "homepage": "https://tskit.getcommunity.com",
  "items": [
    {
      "name": "tanstack-solid-config",
      "title": "TanStack SolidJS Tailwind Application Config",
      "description": "A base config files for a tanstack, solidjs, tailwindcss application",
      "dependencies": [
        "@eslint/eslintrc",
        "@eslint/js",
        "@tanstack/eslint-config",
        "typescript-eslint",
        "@getcommunity/client-styleguides",
        "@kobalte/tailwindcss",
        "@tailwindcss/typography",
        "tailwindcss"
      ],
      "registryDependencies": [
        "dev-scripts"
      ],
      "files": [
        {
          "path": "registry/config/components.json",
          "type": "registry:file",
          "target": "@/components.json"
        },
        {
          "path": "registry/config/eslint.config-tanstack.mjs",
          "type": "registry:file",
          "target": "@/eslint.config.js"
        },
        {
          "path": "registry/config/prettier.config-tailwind.mjs",
          "type": "registry:file",
          "target": "@/prettier.config.js"
        },
        {
          "path": "registry/config/tailwind.config.mjs",
          "type": "registry:file",
          "target": "@/tailwind.config.mjs"
        }
      ],
      "type": "registry:item"
    },
    {
      "name": "hook-use-infinite-query",
      "title": "Use Infinite Query",
      "description": "A TanStack Query hook for fetching paginated Strapi data infinitely",
      "dependencies": [
        "@tanstack/solid-query",
        "@getcommunity/gc-validators"
      ],
      "files": [
        {
          "path": "registry/hooks/use-infinite-query.ts",
          "type": "registry:hook",
          "target": "hooks/use-infinite-query.ts"
        }
      ],
      "type": "registry:hook"
    },
    {
      "name": "hook-use-mobile",
      "title": "Use Mobile",
      "description": "A hook for matching mobile viewport sizes",
      "files": [
        {
          "path": "registry/hooks/use-mobile.ts",
          "type": "registry:hook",
          "target": "hooks/use-mobile.ts"
        }
      ],
      "type": "registry:hook"
    },
    {
      "name": "lib-utils-date",
      "title": "Date Utilities",
      "description": "Date and time utility scripts",
      "dependencies": [
        "@internationalized/date"
      ],
      "files": [
        {
          "path": "registry/lib/utils/date.ts",
          "type": "registry:file",
          "target": "lib/utils/date.ts"
        }
      ],
      "type": "registry:item"
    },
    {
      "name": "lib-utils-script-tag",
      "title": "Script Tag Utilities",
      "description": "Utilities for handling <script> tag injection",
      "files": [
        {
          "path": "registry/lib/utils/script-tag.ts",
          "type": "registry:file",
          "target": "lib/utils/script-tag.ts"
        }
      ],
      "type": "registry:item"
    },
    {
      "name": "lib-utils-tailwind",
      "title": "Tailwind Utilities",
      "description": "Tailwind utility scripts (cn)",
      "dependencies": [
        "tailwind-merge",
        "clsx"
      ],
      "files": [
        {
          "path": "registry/lib/utils/tailwind.ts",
          "type": "registry:file",
          "target": "lib/utils/tailwind.ts"
        }
      ],
      "type": "registry:item"
    },
    {
      "name": "dev-scripts",
      "title": "Development Scripts",
      "description": "Essential scripts used for development",
      "files": [
        {
          "path": "registry/scripts/.pre-commit-config.yaml",
          "type": "registry:file",
          "target": "@/.pre-commit-config.yaml"
        },
        {
          "path": "registry/scripts/format.sh",
          "type": "registry:file",
          "target": "@/scripts/format.sh"
        },
        {
          "path": "registry/scripts/lint.sh",
          "type": "registry:file",
          "target": "@/scripts/lint.sh"
        },
        {
          "path": "registry/scripts/test.sh",
          "type": "registry:file",
          "target": "@/scripts/test.sh"
        }
      ],
      "type": "registry:item"
    }
  ]
}