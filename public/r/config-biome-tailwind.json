{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "config-biome-tailwind",
  "title": "Biome Config Tailwind",
  "description": "Tailwind v4 CSS parsing/formatting/linting layered on top of config-biome-base.",
  "files": [
    {
      "path": "registry/config/biome/biome.tailwind.jsonc",
      "content": "{\n  \"$schema\": \"https://biomejs.dev/schemas/2.6.3/schema.json\",\n  \"css\": {\n    \"parser\": {\n      \"tailwindDirectives\": true\n    },\n    \"formatter\": {\n      \"enabled\": true\n    },\n    \"linter\": {\n      \"enabled\": true\n    }\n  },\n  \"tailwind\": {\n    \"stylesheet\": \"src/app.css\"\n  }\n}\n",
      "type": "registry:file",
      "target": "biome.tailwind.jsonc"
    }
  ],
  "type": "registry:item"
}